datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum BankType {
  bank
  finance
}

enum Sector {
  government
  semi_government
  private
  self_employed
}

enum TargetOccupation {
  all
  doctor
  engineer
  gov_exec
}

enum LoanCategory {
  personal
  professional
  housing
  vehicle
  business
}

enum UserRole {
  user
  admin
}

enum AuthProvider {
  email
  google
  facebook
}

/// SRS Appendix B.1 — one row per bank/finance-company product record.
model Bank {
  id                   String             @id @default(cuid())
  name                 String
  shortName            String
  type                 BankType
  active               Boolean            @default(true)
  sponsored            Boolean            @default(false)
  baseRate             Decimal            @db.Decimal(5, 2)
  docChargePct         Decimal            @db.Decimal(5, 2)
  docChargeMin         Int
  docChargeCap         Int
  maxTermPersonal      Int                @default(0)
  maxTermProfessional  Int                @default(0)
  maxTermHousing       Int                @default(0)
  maxTermVehicle       Int                @default(0)
  maxTermBusiness      Int                @default(0)
  /// Explicit override; null = fall back to baseRate - professionalSchemeDiscount
  specialRate          Decimal?           @db.Decimal(5, 2)
  /// Explicit override; null = fall back to docChargePct
  specialDocChargePct  Decimal?           @db.Decimal(5, 2)
  /// Explicit override; null = fall back to maxTermProfessional
  specialMaxTermYears  Int?
  allowedSectors       Sector[]
  /// Gates the Special Scheme variant only (SRS §3.5.3). null/'all' = unrestricted.
  targetOccupation     TargetOccupation?
  remarks              String[]
  specialSchemeRemarks String[]
  color                String?
  /// Per-bank "rates effective" date — never a single global claim (SRS §3.5.5).
  updatedDate          DateTime           @db.Date
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  leads                Lead[]

  @@map("banks")
}

/// SRS Appendix B.2 — admin-editable profession list, drives Step 2 dropdown + dual-scheme gating.
model Occupation {
  id                      String   @id @default(cuid())
  slug                    String   @unique
  label                   String
  isSpecialSchemeEligible Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@map("occupations")
}

/// SRS §5.3 — global engine configuration. Single row, id always 1.
model Settings {
  id                         Int      @id @default(1)
  dtiGovernment              Int      @default(70)
  dtiSemiGovernment          Int      @default(65)
  dtiPrivate                 Int      @default(60)
  dtiSelfEmployed            Int      @default(55)
  specialOccupationDiscount  Decimal  @default(0.75) @db.Decimal(5, 2)
  specialOccupationEnabled   Boolean  @default(true)
  professionalSchemeDiscount Decimal  @default(1.5) @db.Decimal(5, 2)
  professionalSchemeEnabled  Boolean  @default(true)
  /// 0 = exact (no rounding)
  loanRoundingStep           Int      @default(50000)
  businessLoanEnabled        Boolean  @default(false)
  updatedAt                  DateTime @updatedAt

  @@map("settings")
}

/// Separate source of truth for admin access, decoupled from the general User record.
model Admin {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("admins")
}

/// SRS §6.1 — auth records. A guest has no row here at all (isRestricted = !user).
model User {
  id           String        @id @default(cuid())
  email        String?       @unique
  passwordHash String?
  name         String?
  role         UserRole      @default(user)
  active       Boolean       @default(true)
  authProvider AuthProvider  @default(email)
  oauthId      String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  applications Application[]
  auditLogs    AuditLog[]
  admin        Admin?

  @@unique([authProvider, oauthId])
  @@map("users")
}

/// SRS Appendix B.3 — one row per completed/abandoned eligibility session (never for guests).
model Application {
  id              String       @id @default(cuid())
  userId          String?
  user            User?        @relation(fields: [userId], references: [id])
  loanCategory    LoanCategory
  sector          Sector
  occupationId    String?
  age             Int
  retirementAge   Int
  incomeProfile   Json
  categoryDetails Json
  resultsSnapshot Json
  createdAt       DateTime     @default(now())

  @@map("applications")
}

/// SRS Appendix B.4 — full consultation lead requests.
model Lead {
  id              String       @id @default(cuid())
  applicationId   String?
  name            String
  phone           String
  city            String?
  branch          String?
  bankId          String?
  bank            Bank?        @relation(fields: [bankId], references: [id])
  variantKey      String?
  loanCategory    LoanCategory
  requestedAmount Int?
  createdAt       DateTime     @default(now())

  @@map("leads")
}

/// SRS Appendix B.5 — lightweight soft-leads (name + phone only).
model CallbackRequest {
  id            String       @id @default(cuid())
  applicationId String?
  name          String
  phone         String
  loanCategory  LoanCategory
  createdAt     DateTime     @default(now())

  @@map("callback_requests")
}

/// SRS Appendix B.6 — every Admin Console mutation, required for compliance (§5.5).
model AuditLog {
  id          String   @id @default(cuid())
  adminUserId String
  adminUser   User     @relation(fields: [adminUserId], references: [id])
  entityType  String
  entityId    String
  field       String
  oldValue    String?
  newValue    String?
  changedAt   DateTime @default(now())

  @@map("audit_log")
}
