JWT_EXPIRES_IN=7d

# OAuth — leave blank to disable; email/password auth works without these.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:4000/auth/facebook/callback

# OCR provider — "mock" (no external calls), "gemini" (Gemini vision model, needs GEMINI_API_KEY below),
# or "textract" / "document-ai" once wired up.
