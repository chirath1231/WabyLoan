# Local PostgreSQL — adjust user/password to match your local instance.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/WabyLoan?schema=public"

PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed to call this API (the web app's dev/prod URLs).
CORS_ORIGINS=http://localhost:3000

JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=7d

# OAuth — leave blank to disable; email/password auth works without these.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:4000/auth/facebook/callback

# OCR provider — "mock" (default, no external calls) or "textract" / "document-ai" once wired up.
OCR_PROVIDER=mock
